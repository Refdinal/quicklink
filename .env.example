# Connection string dari dashboard Neon (Project > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Password untuk masuk ke aplikasi
APP_PASSWORD=ganti-dengan-password-kamu

# Secret acak untuk menandatangani cookie login (ganti dengan string acak panjang)
AUTH_SECRET=ganti-dengan-string-acak-panjang
